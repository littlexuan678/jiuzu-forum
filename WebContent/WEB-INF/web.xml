<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>九组论坛 JiuZu Forum</display-name>

    <!-- 应用启动监听器：初始化数据库 -->
    <listener>
        <listener-class>com.jiuzu.forum.util.AppListener</listener-class>
    </listener>

    <!-- 全局编码过滤器：统一 UTF-8，解决中文乱码 -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.jiuzu.forum.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 登录拦截过滤器：保护需要登录后才能访问的资源 -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.jiuzu.forum.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/post/add</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/post/delete</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/reply/add</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/reply/delete</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/like</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- ===================== Servlet 配置 ===================== -->

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.jiuzu.forum.web.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.jiuzu.forum.web.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.jiuzu.forum.web.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostEditServlet</servlet-name>
        <servlet-class>com.jiuzu.forum.web.PostEditServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>10485760</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostEditServlet</servlet-name>
        <url-pattern>/post/edit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostListServlet</servlet-name>
        <servlet-class>com.jiuzu.forum.web.PostListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostListServlet</servlet-name>
        <url-pattern>/posts</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostDetailServlet</servlet-name>
        <servlet-class>com.jiuzu.forum.web.PostDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostDetailServlet</servlet-name>
        <url-pattern>/post/detail</url-pattern>
    </servlet-mapping>

    <!-- 发帖：支持配图上传（multipart） -->
    <servlet>
        <servlet-name>PostAddServlet</servlet-name>
        <servlet-class>com.jiuzu.forum.web.PostAddServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>10485760</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostAddServlet</servlet-name>
        <url-pattern>/post/add</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostDeleteServlet</servlet-name>
        <servlet-class>com.jiuzu.forum.web.PostDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostDeleteServlet</servlet-name>
        <url-pattern>/post/delete</url-pattern>
    </servlet-mapping>

    <!-- 回复：支持配图上传（multipart） -->
    <servlet>
        <servlet-name>ReplyAddServlet</servlet-name>
        <servlet-class>com.jiuzu.forum.web.ReplyAddServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>10485760</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReplyAddServlet</servlet-name>
        <url-pattern>/reply/add</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReplyDeleteServlet</servlet-name>
        <servlet-class>com.jiuzu.forum.web.ReplyDeleteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReplyDeleteServlet</servlet-name>
        <url-pattern>/reply/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LikeServlet</servlet-name>
        <servlet-class>com.jiuzu.forum.web.LikeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LikeServlet</servlet-name>
        <url-pattern>/like</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.jiuzu.forum.web.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AiServlet</servlet-name>
        <servlet-class>com.jiuzu.forum.web.AiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AiServlet</servlet-name>
        <url-pattern>/ai</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AiServlet</servlet-name>
        <url-pattern>/ai/chat</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- 错误页 -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/error/404.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/WEB-INF/jsp/error/500.jsp</location>
    </error-page>

    <!-- Session 超时时间：30 分钟 -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
</web-app>
