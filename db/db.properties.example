# 数据库切换配置（可选）
#
# 默认使用 SQLite，无需此文件。
# 若要改用 MySQL：把本文件复制为 src/db.properties，改好下面的连接信息，
# 编译后 DAO 层会自动切换驱动与连接串（业务代码不用改）。
#
# 需要先执行 db/schema-mysql.sql 建库建表。

db.type=mysql
db.url=jdbc:mysql://localhost:3306/jiuzu_forum?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
db.username=root
db.password=123456
